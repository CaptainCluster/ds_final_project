{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "scripts": {
    "start": "npm-run-all --parallel start:database start:handler",
    "start:database": "cd database && npm run prod",
    "start:handler": "cd handler && npm run prod",
    "dev": "npm-run-all --parallel dev:database dev:handler",
    "dev:database": "cd database && npm run dev",
    "dev:handler": "cd handler && npm run dev",
    "install": "npm install && npm-run-all --parallel install:database install:handler",
    "install:database": "cd database && npm install",
    "install:handler": "cd handler && npm install"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  }
}
